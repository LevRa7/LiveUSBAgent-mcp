#!/usr/bin/env bash
# ops/live-usb/hooks/0300-purge-build-deps.hook.chroot
# Remote-Harness LiveUSB (Debian 13 "Trixie") post-build cleanup hook.
#
# 0100-... builds apfs-fuse from source, which needs a full compiler toolchain,
# kernel headers and dev libraries inside the chroot. None of that is useful at
# runtime, and keeping it would add hundreds of MB to the squashfs - critical
# for the "toram" boot mode that copies the whole image into RAM.
#
# Runs last (lexical hook order: 0100 -> 0200 -> 0300). Every step is
# non-fatal: a failure here leaves the image bigger but still bootable.

set -uo pipefail

log() {
    echo "[rhm-purge] $*"
}

warn() {
    echo "[rhm-purge] WARNING: $*" >&2
}

# 1. Pin the runtime libraries used by /usr/local/bin/apfs-fuse as manually
#    installed, so apt autoremove cannot take them away with the -dev packages.
runtime_libs=(libfuse3-3 libbz2-1.0 zlib1g libattr1 libicu72 libicu76)
for lib in "${runtime_libs[@]}"; do
    if dpkg-query -W -f='${Status}' "${lib}" 2>/dev/null | grep -q "install ok installed"; then
        apt-mark manual "${lib}" >/dev/null 2>&1 || warn "could not mark ${lib} manual"
    fi
done

# 1b. Back up compiled DKMS kernel modules before purging build-only packages
#     (removing linux-headers-* can trigger DKMS hooks that delete updates/dkms/*.ko*).
DKMS_BACKUP_DIR="/tmp/rhm-dkms-ko-backup"
rm -rf "${DKMS_BACKUP_DIR}"
mkdir -p "${DKMS_BACKUP_DIR}"

mod_roots=()
if [[ -d /usr/lib/modules ]]; then
    mod_roots+=(/usr/lib/modules)
fi
if [[ -d /lib/modules && ! -L /lib && ! -L /lib/modules ]]; then
    if [[ "$(readlink -f /lib/modules 2>/dev/null || true)" != "$(readlink -f /usr/lib/modules 2>/dev/null || true)" ]]; then
        mod_roots+=(/lib/modules)
    fi
fi

backed_up_ko=0
for mod_root in "${mod_roots[@]}"; do
    for dkms_dir in "${mod_root}"/*/updates/dkms; do
        [[ -d "${dkms_dir}" ]] || continue
        kver="$(basename "$(dirname "$(dirname "${dkms_dir}")")")"
        dst_dir="${DKMS_BACKUP_DIR}/${kver}/updates/dkms"
        while IFS= read -r -d '' ko_file; do
            rel_path="${ko_file#"${dkms_dir}"/}"
            mkdir -p "${dst_dir}/$(dirname "${rel_path}")"
            if cp -a "${ko_file}" "${dst_dir}/${rel_path}"; then
                backed_up_ko=$((backed_up_ko + 1))
            else
                warn "could not back up DKMS module: ${ko_file}"
            fi
        done < <(find "${dkms_dir}" -type f \( -name '*.ko' -o -name '*.ko.xz' -o -name '*.ko.zst' \) -print0 2>/dev/null)
    done
done
log "Backed up ${backed_up_ko} compiled DKMS module file(s) to ${DKMS_BACKUP_DIR}."

# 2. Remove the build-only toolchain, headers and dev libraries.
build_only=(
    build-essential
    gcc
    g++
    make
    cmake
    git
    linux-headers-amd64
    linux-headers-arm64
    linux-headers-686-pae
    libfuse3-dev
    libbz2-dev
    libattr1-dev
    zlib1g-dev
    libmnl-dev
    libelf-dev
    pkg-config
)
installed_build_only=()
for pkg in "${build_only[@]}"; do
    if dpkg-query -W -f='${Status}' "${pkg}" 2>/dev/null | grep -q "install ok installed"; then
        installed_build_only+=("${pkg}")
    fi
done
if [[ ${#installed_build_only[@]} -gt 0 ]]; then
    log "Purging build-only packages: ${installed_build_only[*]}"
    if ! DEBIAN_FRONTEND=noninteractive apt-get purge -y --auto-remove "${installed_build_only[@]}"; then
        warn "apt-get purge returned non-zero; image may still contain build dependencies."
    fi
fi

# 2b. Restore backed-up DKMS kernel modules, remove temp backup, and run depmod.
primary_mod_root="/usr/lib/modules"
if [[ ! -d "${primary_mod_root}" && -d /lib/modules ]]; then
    primary_mod_root="/lib/modules"
fi

if [[ -d "${DKMS_BACKUP_DIR}" ]]; then
    restored_ko=0
    for kver_backup in "${DKMS_BACKUP_DIR}"/*; do
        [[ -d "${kver_backup}/updates/dkms" ]] || continue
        kver="$(basename "${kver_backup}")"
        if [[ -d "/usr/lib/modules/${kver}" ]]; then
            target_dkms="/usr/lib/modules/${kver}/updates/dkms"
        elif [[ -d "/lib/modules/${kver}" ]]; then
            target_dkms="/lib/modules/${kver}/updates/dkms"
        else
            target_dkms="${primary_mod_root}/${kver}/updates/dkms"
        fi
        mkdir -p "${target_dkms}"
        while IFS= read -r -d '' ko_file; do
            rel_path="${ko_file#"${kver_backup}/updates/dkms"/}"
            mkdir -p "${target_dkms}/$(dirname "${rel_path}")"
            if cp -a "${ko_file}" "${target_dkms}/${rel_path}"; then
                restored_ko=$((restored_ko + 1))
            else
                warn "could not restore DKMS module: ${target_dkms}/${rel_path}"
            fi
        done < <(find "${kver_backup}/updates/dkms" -type f \( -name '*.ko' -o -name '*.ko.xz' -o -name '*.ko.zst' \) -print0 2>/dev/null)
    done
    rm -rf "${DKMS_BACKUP_DIR}" || warn "could not remove ${DKMS_BACKUP_DIR}"
    log "Restored ${restored_ko} compiled DKMS module file(s)."
fi

if command -v depmod >/dev/null 2>&1 && [[ -d "${primary_mod_root}" ]]; then
    for kdir in "${primary_mod_root}"/*; do
        [[ -d "${kdir}" ]] || continue
        kver="$(basename "${kdir}")"
        if depmod -a "${kver}"; then
            log "depmod -a ${kver} completed."
        else
            warn "depmod -a ${kver} returned non-zero."
        fi
    done
fi

# 2c. Diagnostic check: verify DKMS modules via modinfo after purge (non-fatal).
if command -v modinfo >/dev/null 2>&1 && [[ -d "${primary_mod_root}" ]]; then
    for kdir in "${primary_mod_root}"/*; do
        [[ -d "${kdir}" ]] || continue
        kver="$(basename "${kdir}")"
        for mod in zfs apfs amneziawg; do
            mod_path="$(modinfo -k "${kver}" -n "${mod}" 2>/dev/null || true)"
            if [[ -n "${mod_path}" ]]; then
                log "modinfo (${kver}): ${mod} -> ${mod_path}"
            else
                log "modinfo (${kver}): ${mod} not present (may not be built in this profile)"
            fi
        done
    done
fi

# 3. Drop kernel header trees that apt left behind because of a metapackage pin.
for hdr in /usr/src/linux-headers-*; do
    [[ -d "${hdr}" ]] || continue
    log "Removing leftover kernel headers: ${hdr}"
    rm -rf "${hdr}" || warn "could not remove ${hdr}"
done

# 4. Sanity check: the shipped apfs-fuse must still resolve its libraries.
if [[ -x /usr/local/bin/apfs-fuse ]] && command -v ldd >/dev/null 2>&1; then
    missing="$(ldd /usr/local/bin/apfs-fuse 2>/dev/null | grep 'not found' || true)"
    if [[ -n "${missing}" ]]; then
        warn "apfs-fuse has unresolved libraries after purge: ${missing}"
    else
        log "apfs-fuse runtime libraries verified."
    fi
fi

# 5. For compact/lite profiles, trim docs, manpages, info, and unused locales (keep en/ru).
LIVE_PROFILE="full"
if [[ -f /etc/rhm-live-profile ]]; then
    LIVE_PROFILE="$(tr -d '\r\n' < /etc/rhm-live-profile)"
fi
if [[ "${LIVE_PROFILE}" == "compact" || "${LIVE_PROFILE}" == "lite" ]]; then
    log "Profile=${LIVE_PROFILE}: trimming /usr/share/doc, /usr/share/man, /usr/share/info, and non-en/ru locales..."
    find /usr/share/doc -depth -type f ! -name copyright -delete 2>/dev/null || true
    rm -rf /usr/share/man/* /usr/share/info/* /usr/share/lintian/* /usr/share/linda/* 2>/dev/null || true
    if [[ -d /usr/share/locale ]]; then
        for loc in /usr/share/locale/*; do
            base="$(basename "${loc}")"
            case "${base}" in
                en|en_*|ru|ru_*|locale.alias) ;;
                *) rm -rf "${loc}" 2>/dev/null || true ;;
            esac
        done
    fi
    rm -rf /var/lib/apt/lists/* 2>/dev/null || true
fi

# 6. Trim package caches and finish.
apt-get clean || true
log "Build-dependency purge complete (profile=${LIVE_PROFILE})."
